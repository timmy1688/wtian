{
 "1": {
  "guaxu": 1,
  "guaming": "乾为天",
  "jianming": "乾",
  "guaci": "元亨利贞。",
  "daxiang": "天行健，君子以自强不息。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "潜龙，勿用。",
    "xiaoxiang": "“潜龙，勿用”，阳在下也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "见龙在田，利见大人。",
    "xiaoxiang": "“见龙在田”，德施普也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "君子终日乾乾，夕惕若，厉无咎。",
    "xiaoxiang": "“终日乾乾”，反复道也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "或跃在渊，无咎。",
    "xiaoxiang": "“或跃在渊”，进无咎也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "飞龙在天，利见大人。",
    "xiaoxiang": "“飞龙在天”，“大人”造也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "亢龙有悔。",
    "xiaoxiang": "“亢龙有悔”，盈不可久也。"
   }
  ],
  "yong": {
   "yaoming": "用九",
   "yaoci": "见群龙无首，吉。",
   "xiaoxiang": "“用九”，天德不可为首也。"
  }
 },
 "2": {
  "guaxu": 2,
  "guaming": "坤为地",
  "jianming": "坤",
  "guaci": "元亨，利牝马之贞。君子有攸往，先迷，后得主，利。西南得朋，东北丧朋。安贞吉。",
  "daxiang": "地势坤，君子以厚德载物。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "履霜，坚冰至。",
    "xiaoxiang": "“履霜坚冰”，阴始凝也；驯致其道，至坚冰也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "直方大，不习无不利。",
    "xiaoxiang": "六二之动，“直”以“方”也。“不习无不利”，地道光也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "含章可贞；或从王事，无成有终。",
    "xiaoxiang": "“含章可贞”，以时发也；“或从王事”，知光大也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "括囊，无咎无誉。",
    "xiaoxiang": "“括囊无咎”，慎不害也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "黄裳，元吉。",
    "xiaoxiang": "“黄裳元吉”，文在中也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "龙战于野，其血玄黄。",
    "xiaoxiang": "“龙战于野”，其道穷也。"
   }
  ],
  "yong": {
   "yaoming": "用六",
   "yaoci": "利永贞。",
   "xiaoxiang": "用六“永贞”，以大终也。"
  }
 },
 "3": {
  "guaxu": 3,
  "guaming": "水雷屯",
  "jianming": "屯",
  "guaci": "元亨，利贞；勿用有攸往，利建侯。",
  "daxiang": "云雷，屯。君子以经纶。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "磐桓；利居贞，利建侯。",
    "xiaoxiang": "虽磐桓，志行正也；以贵下贱，大得民也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "屯如，邅如，乘马班如。匪寇婚媾。女子贞不字，十年乃字。",
    "xiaoxiang": "六二之难，乘刚也。“十年乃字”，反常也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "即鹿无虞，惟入于林中，君子几，不如舍，往吝。",
    "xiaoxiang": "“即鹿无虞”，以从禽也。君子舍之；“往吝”，穷也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "乘马班如，求婚媾，往吉，无不利。",
    "xiaoxiang": "“求”而“往”，明也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "屯其膏，小贞吉，大贞凶。",
    "xiaoxiang": "“屯其膏”，施未光也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "乘马班如，泣血涟如。",
    "xiaoxiang": "“泣血涟如”，何可长也？"
   }
  ]
 },
 "4": {
  "guaxu": 4,
  "guaming": "山水蒙",
  "jianming": "蒙",
  "guaci": "亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
  "daxiang": "山下出泉，蒙。君子以果行育德。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "发蒙，利用刑人，用说桎梏；以往吝。",
    "xiaoxiang": "“利用刑人”，以正法也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "包蒙，吉。纳妇，吉；子克家。",
    "xiaoxiang": "“子克家”，刚柔接也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "勿用取女，见金夫，不有躬，无攸利。",
    "xiaoxiang": "“勿用取女”，行不顺也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "困蒙，吝。",
    "xiaoxiang": "“困蒙”之“吝”，独远实也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "童蒙，吉。",
    "xiaoxiang": "“童蒙”之“吉”，顺以巽也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "击蒙；不利为寇，利御寇。",
    "xiaoxiang": "“利”用“御寇”，上下顺也。"
   }
  ]
 },
 "5": {
  "guaxu": 5,
  "guaming": "水天需",
  "jianming": "需",
  "guaci": "有孚，光亨，贞吉，利涉大川。",
  "daxiang": "云上于天，需。君子以饮食宴乐。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "需于郊，利用恒，无咎。",
    "xiaoxiang": "“需于郊”，不犯难行也；“利用恒，无咎”，未失常也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "需于沙，小有言；终吉。",
    "xiaoxiang": "“需于沙”，衍在中也；虽“小有言”，以“吉”“终”也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "需于泥，致寇至。",
    "xiaoxiang": "“需于泥”，灾在外也；自我“致寇”，敬慎不败也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "需于血，出自穴。",
    "xiaoxiang": "“需于血”，顺以听也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "需于酒食，贞吉。",
    "xiaoxiang": "“酒食，贞吉”，以中正也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "入于穴，有不速之客三人来；敬之，终吉。",
    "xiaoxiang": "“不速之客”来，“敬之，终吉”，虽不当位，未大失也。"
   }
  ]
 },
 "6": {
  "guaxu": 6,
  "guaming": "天水讼",
  "jianming": "讼",
  "guaci": "有孚，窒惕，中吉；终凶。利见大人，不利涉大川。",
  "daxiang": "天与水违行，讼。君子以作事谋始。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "不永所事，小有言，终吉。",
    "xiaoxiang": "“不永所事”，讼不可长也；虽“有小言”，其辩明也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "不克讼，归而逋，其邑人三百户，无眚。",
    "xiaoxiang": "“不克讼”，归逋，窜也；自下讼上，患至掇也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "食旧德，贞厉，终吉；或从王事，无成。",
    "xiaoxiang": "“食旧德”，从上吉也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "不克讼；复即命，渝，安贞，吉。",
    "xiaoxiang": "“复即命，渝”，“安贞”不失也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "讼，元吉。",
    "xiaoxiang": "“讼，元吉”，以中正也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "或锡之鞶带，终朝三褫之。",
    "xiaoxiang": "以讼受服，亦不足敬也。"
   }
  ]
 },
 "7": {
  "guaxu": 7,
  "guaming": "地水师",
  "jianming": "师",
  "guaci": "贞，丈人吉，无咎。",
  "daxiang": "地中有水，师。君子以容民畜众。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "师出以律，否臧凶。",
    "xiaoxiang": "“师出以律”，失律“凶”也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "在师中吉，无咎；王三锡命。",
    "xiaoxiang": "“在师中吉”，承天宠也；“王三锡命”，怀万邦也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "师或舆尸，凶。",
    "xiaoxiang": "“师或舆尸”，大无功也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "师左次，无咎。",
    "xiaoxiang": "“左次，无咎”，未失常也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "田有禽，利执言，无咎；长子帅师，弟子舆尸，贞凶。",
    "xiaoxiang": "“长子帅师”，以中行也；“弟子舆师”，使不当也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "大君有命，开国承家，小人勿用。",
    "xiaoxiang": "“大君有命”，以正功也；“小人勿用”，必乱邦也。"
   }
  ]
 },
 "8": {
  "guaxu": 8,
  "guaming": "水地比",
  "jianming": "比",
  "guaci": "吉。原筮，元永贞，无咎。不宁方来，后夫凶。",
  "daxiang": "地上有水，比。先王以建万国，亲诸侯。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "有孚比之，无咎；有孚盈缶，终来有它，吉。",
    "xiaoxiang": "比之初六，有它吉也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "比之自内，贞吉。",
    "xiaoxiang": "“比之自内”，不自失也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "比之匪人。",
    "xiaoxiang": "“比之匪人”，不亦伤乎！"
   },
   {
    "yaoming": "六四",
    "yaoci": "外比之，贞吉。",
    "xiaoxiang": "“外比”于贤，以从上也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "显比；王用三驱，失前禽。邑人不诫，吉。",
    "xiaoxiang": "“显比”之吉，位正中也。舍逆取顺，“失前禽”也。“邑人不诫”，上使中也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "比之无首，凶。",
    "xiaoxiang": "“比之无首”，无所终也。"
   }
  ]
 },
 "9": {
  "guaxu": 9,
  "guaming": "风天小畜",
  "jianming": "小畜",
  "guaci": "亨。密云不雨，自我西郊。",
  "daxiang": "风行天上，小畜。君子以懿文德。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "复自道，何其咎？吉。",
    "xiaoxiang": "“复自道”，其义“吉”也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "牵复，吉。",
    "xiaoxiang": "“牵复”在中，亦不自失也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "舆说辐，夫妻反目。",
    "xiaoxiang": "“夫妻反目”，不能正室也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "有孚，血去惕出，无咎。",
    "xiaoxiang": "“有孚”“惕出”，上合志也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "有孚挛如，富以其邻。",
    "xiaoxiang": "“有孚挛如”，不独富也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "既雨既处，尚德载；妇贞厉，月几望；君子征凶。",
    "xiaoxiang": "“既雨既处”，“德”积“载”也。“君子征凶”，有所疑也。"
   }
  ]
 },
 "10": {
  "guaxu": 10,
  "guaming": "天泽履",
  "jianming": "履",
  "guaci": "履虎尾，不咥人，亨。",
  "daxiang": "上天下泽，履。君子以辨上下，定民志。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "素履，往，无咎。",
    "xiaoxiang": "“素履”之“往”，独行愿也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "履道坦坦，幽人贞吉。",
    "xiaoxiang": "“幽人贞吉”，中不自乱也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "眇能视，跛能履，履虎尾，咥人，凶；武人为于大君。",
    "xiaoxiang": "“眇能视”，不足以有明也；“跛能履”，不足以与行也；“咥人之凶”，位不当也；“武人为于大君”，志刚也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "履虎尾，愬愬，终吉。",
    "xiaoxiang": "“愬愬，终吉”，志行也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "夬履，贞厉。",
    "xiaoxiang": "“夬履，贞厉”，位正当也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "视履考祥，其旋元吉。",
    "xiaoxiang": "元吉在上，大有庆也。"
   }
  ]
 },
 "11": {
  "guaxu": 11,
  "guaming": "地天泰",
  "jianming": "泰",
  "guaci": "小往大来，吉，亨。",
  "daxiang": "天地交，泰。后以财成天地之道，辅相天地之宜，以左右民。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "拔茅茹，以其汇，征吉。",
    "xiaoxiang": "“拔茅”“征吉”，志在外也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "包荒，用冯河，不遐遗；朋亡，得尚于中行。",
    "xiaoxiang": "“包荒”，“得尚于中行”，以光大也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "无平不陂，无往不复；艰贞无咎，勿恤其孚，于食有福。",
    "xiaoxiang": "“无往不复”，天地际也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "翩翩，不富，以其邻，不戒以孚。",
    "xiaoxiang": "“翩翩，不富”，皆失实也。“不戒以孚”，中心愿也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "帝乙归妹，以祉元吉。",
    "xiaoxiang": "“以祉元吉”，中以行愿也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "城复于隍，勿用师，自邑告命，贞吝。",
    "xiaoxiang": "“城复于隍”，其命乱也。"
   }
  ]
 },
 "12": {
  "guaxu": 12,
  "guaming": "天地否",
  "jianming": "否",
  "guaci": "否之匪人，不利君子贞，大往小来。",
  "daxiang": "天地不交，否。君子以俭德辟难，不可荣以禄。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "拔茅茹，以其汇，贞吉，亨。",
    "xiaoxiang": "“拔茅”“贞吉”，志在君也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "包承，小人吉。大人否，亨。",
    "xiaoxiang": "“大人否，亨”，不乱群也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "包羞。",
    "xiaoxiang": "“包羞”，位不当也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "有命无咎，畴离祉。",
    "xiaoxiang": "“有命无咎”，志行也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "休否，大人吉；其亡其亡，系于苞桑。",
    "xiaoxiang": "“大人”之“吉”，位正当也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "倾否，先否后喜。",
    "xiaoxiang": "否终则倾，何可长也？"
   }
  ]
 },
 "13": {
  "guaxu": 13,
  "guaming": "天火同人",
  "jianming": "同人",
  "guaci": "同人于野，亨。利涉大川，利君子贞。",
  "daxiang": "天与火，同人。君子以类族辨物。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "同人于门，无咎。",
    "xiaoxiang": "出门同人，又谁“咎”也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "同人于宗，吝。",
    "xiaoxiang": "“同人于宗”，吝道也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "伏戎于莽，升其高陵，三岁不兴。",
    "xiaoxiang": "“伏戎于莽”，敌刚也；“三岁不兴”，安行也？"
   },
   {
    "yaoming": "九四",
    "yaoci": "乘其墉，弗克攻，吉。",
    "xiaoxiang": "“乘其墉”，义弗克也；其吉，则困而反则也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "同人，先号咷，而后笑，大师克相遇。",
    "xiaoxiang": "“同人”之先，以中直也。大师相遇，言相克也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "同人于郊，无悔。",
    "xiaoxiang": "“同人于郊”，志未得也。"
   }
  ]
 },
 "14": {
  "guaxu": 14,
  "guaming": "火天大有",
  "jianming": "大有",
  "guaci": "元亨。",
  "daxiang": "火在天上，大有。君子以遏恶扬善，顺天休命。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "无交害，匪咎；艰则无咎。",
    "xiaoxiang": "大有初九，“无交害”也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "大车以载，有攸往，无咎。",
    "xiaoxiang": "“大车以载”，积中不败也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "公用亨于天子，小人弗克。",
    "xiaoxiang": "“公用亨于天子”，小人害也。"
   },
   {
    "yaoming": "九四",
