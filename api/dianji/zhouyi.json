    "xiaoxiang": "“拘系之”，上穷也。"
   }
  ]
 },
 "18": {
  "guaxu": 18,
  "guaming": "山风蛊",
  "jianming": "蛊",
  "guaci": "元亨，利涉大川。先甲三日，后甲三日。",
  "daxiang": "山下有风，蛊。君子以振民育德。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "干父之蛊，有子，考无咎，厉终吉。",
    "xiaoxiang": "“干父之蛊”，意承考也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "干母之蛊，不可贞。",
    "xiaoxiang": "“干母之蛊”，得中道也。"
   },
   {
