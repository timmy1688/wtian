  "jianming": "习坎",
  "guaci": "有孚，维心亨。行有尚。",
  "daxiang": "水洊至，习坎。君子以常德行，习教事。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "习坎，入于坎窞，凶。",
    "xiaoxiang": "“习坎”入坎，失道凶也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "坎有险，求小得。",
    "xiaoxiang": "“求小得”，未出中也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "来之坎坎，险且枕，入于坎窞，勿用。",
    "xiaoxiang": "“来之坎坎”，终无功也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "樽酒，簋贰，用缶，纳约自牖，终无咎。",
    "xiaoxiang": "“樽酒，簋贰”，刚柔际也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "坎不盈，祗既平，无咎。",
    "xiaoxiang": "“坎不盈”，中未大也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "係用徽纆，寘于丛棘，三岁不得，凶。",
    "xiaoxiang": "上六失道，凶“三岁”也。"
   }
  ]
 },
 "30": {
  "guaxu": 30,
  "guaming": "离为火",
  "jianming": "离",
  "guaci": "利贞，亨。畜牝牛，吉。",
  "daxiang": "明两作，离。大人以继明照于四方。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "履错然，敬之，无咎。",
    "xiaoxiang": "“履错”之“敬”，以辟咎也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "黄离，元吉。",
    "xiaoxiang": "“黄离，元吉”，得中道也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "日昃之离，不鼓缶而歌，则大耋之嗟，凶。",
    "xiaoxiang": "“日昃之离”，何可久也！"
   },
   {
    "yaoming": "九四",
    "yaoci": "突如其来如，焚如，死如，弃如。",
    "xiaoxiang": "“突如其来如”，无所容也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "出涕沱若，戚嗟若，吉。",
    "xiaoxiang": "六五之“吉”，离王公也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "王用出征，有嘉折首，获匪其丑，无咎。",
    "xiaoxiang": "“王用出征”，以正邦也。"
   }
  ]
 },
 "31": {
  "guaxu": 31,
  "guaming": "泽山咸",
  "jianming": "咸",
  "guaci": "亨，利贞。取女吉。",
  "daxiang": "山上有泽，咸。君子以虚受人。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "咸其拇。",
    "xiaoxiang": "“咸其拇”，志在外也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "咸其腓，凶；居吉。",
    "xiaoxiang": "虽“凶”“居吉”，顺不害也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "咸其股，执其随，往吝。",
    "xiaoxiang": "“咸其股”，亦不处也。志在随人，所执下也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "贞吉，悔亡，憧憧往来，朋从尔思。",
    "xiaoxiang": "“贞吉，悔亡”，未感害也；“憧憧往来”，未光大也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "咸其脢，无悔。",
    "xiaoxiang": "“咸其脢”，志未也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "咸其辅颊舌。",
    "xiaoxiang": "“咸其辅颊舌”，滕口说也。"
   }
  ]
 },
 "32": {
  "guaxu": 32,
  "guaming": "雷风恒",
  "jianming": "恒",
  "guaci": "亨，无咎，利贞，利有攸往。",
  "daxiang": "雷风，恒。君子以立不易方。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "浚恒，贞凶，无攸利。",
    "xiaoxiang": "“浚恒”之“凶”，始求深也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "悔亡。",
    "xiaoxiang": "九二“悔亡”，能久中也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "不恒其德，或承之羞；贞吝。",
    "xiaoxiang": "“不恒其德”，无所容也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "田无禽。",
    "xiaoxiang": "久非其位，安得禽也？"
   },
   {
    "yaoming": "六五",
    "yaoci": "恒其德，贞；妇人吉，夫子凶。",
    "xiaoxiang": "“妇人”贞吉，从一而终也。“夫子”制义，从妇凶也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "振恒，凶。",
    "xiaoxiang": "“振恒”在上，大无功也。"
   }
  ]
 },
 "33": {
  "guaxu": 33,
  "guaming": "天山遁",
  "jianming": "遁",
  "guaci": "亨，小利贞。",
  "daxiang": "天下有山，遁。君子以远小人，不恶而严。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "遁尾，厉，勿用有攸往。",
    "xiaoxiang": "“遁尾”之“厉”，不往，何灾也？"
   },
   {
    "yaoming": "六二",
    "yaoci": "执之用黄牛之革，莫之胜说。",
    "xiaoxiang": "“执用黄牛”，固志也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "系遁，有疾厉；畜臣妾，吉。",
    "xiaoxiang": "“系遁之厉”，有疾惫也；“畜臣妾，吉”，不可大事也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "好遁，君子吉，小人否。",
    "xiaoxiang": "“君子”“好遁”，“小人否”也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "嘉遁，贞吉。",
    "xiaoxiang": "“嘉遁，贞吉”，以正志也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "肥遁，无不利。",
    "xiaoxiang": "“肥遁，无不利”，无所疑也。"
   }
  ]
 },
 "34": {
  "guaxu": 34,
  "guaming": "雷天大壮",
  "jianming": "大壮",
  "guaci": "利贞。",
  "daxiang": "雷在天上，大壮。君子以非礼弗履。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "壮于趾，征凶，有孚。",
    "xiaoxiang": "“壮于趾”，其孚穷也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "贞吉。",
    "xiaoxiang": "九二“贞吉”，以中也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "小人用壮，君子用罔；贞厉。羝羊触藩，羸其角。",
    "xiaoxiang": "“小人用壮”，“君子”“罔”也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "贞吉，悔亡；藩决不羸，壮于大舆之輹。",
    "xiaoxiang": "“藩决不羸”，尚往也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "丧羊于易，无悔。",
    "xiaoxiang": "“丧羊于易”，位不当也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "羝羊触藩，不能退，不能遂，无攸利；艰则吉。",
    "xiaoxiang": "“不能退，不能遂”，不详也；“艰则吉”，咎不长也。"
   }
  ]
 },
 "35": {
  "guaxu": 35,
  "guaming": "火地晋",
  "jianming": "晋",
  "guaci": "康侯用锡马蕃庶，昼日三接。",
  "daxiang": "明出地上，晋。君子以自昭明德。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "晋如摧如，贞吉。罔孚，裕无咎。",
    "xiaoxiang": "“晋中摧如”，独行正也。“裕无咎”，未受命也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "晋如愁如，贞吉，受兹介福，于其王母。",
    "xiaoxiang": "“受兹介福”，以中正也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "众允，悔亡。",
    "xiaoxiang": "“众允”之志，上行也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "晋如鼫鼠，贞厉。",
    "xiaoxiang": "“鼫鼠”“贞厉”，位不当也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "悔亡，失得勿恤，往吉，无不利。",
    "xiaoxiang": "“失得勿恤”，往有庆也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "晋其角，维用伐邑，厉吉无咎。贞吝。",
    "xiaoxiang": "“维用伐邑”，道未光也。"
   }
  ]
 },
 "36": {
  "guaxu": 36,
  "guaming": "地火明夷",
  "jianming": "明夷",
  "guaci": "利艰贞。",
  "daxiang": "明入地中，明夷。君子以莅众，用晦而明。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "明夷于飞，垂其翼；君子于行，三日不食。有攸往，主人有言。",
    "xiaoxiang": "“君子于行”，义不食也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "明夷，夷于左股，用拯马壮，吉。",
    "xiaoxiang": "六二之“吉”，顺以则也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "明夷于南狩，得其大首。不可疾贞。",
    "xiaoxiang": "“南狩”之志，乃大得也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "入于左腹，获明夷之心，于出门庭。",
    "xiaoxiang": "“入于左腹”，获心意也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "箕子之明夷，利贞。",
    "xiaoxiang": "“箕子”之“贞”，明不可息也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "不明晦，初登于天，后入于地。",
    "xiaoxiang": "“初登于天”，照四国也。“后入于地”，失则也。"
   }
  ]
 },
 "37": {
  "guaxu": 37,
  "guaming": "风火家人",
  "jianming": "家人",
  "guaci": "利女贞。",
  "daxiang": "风自火出，家人。君子以言有物而行有恒。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "闲有家，悔亡。",
    "xiaoxiang": "“闲有家”，志未变也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "无攸遂，在中馈，贞吉。",
    "xiaoxiang": "六二之“吉”，顺以巽也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "家人嗃嗃，悔厉，吉；妇子嘻嘻，终吝。",
    "xiaoxiang": "“家人嗃嗃”，未失也；“妇子嘻嘻”，失家节也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "富家，大吉。",
    "xiaoxiang": "“富家，大吉”，顺在位也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "王假有家，勿恤，吉。",
    "xiaoxiang": "“王假有家”，交相爱也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "有孚，威如，终吉。",
    "xiaoxiang": "“威如”之“吉”，反身之谓也。"
   }
  ]
 },
 "38": {
  "guaxu": 38,
  "guaming": "火泽睽",
  "jianming": "睽",
  "guaci": "小事吉。",
  "daxiang": "上火下泽，睽；君子以同而异。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "悔亡；丧马勿逐，自复；见恶人，无咎。",
    "xiaoxiang": "“见恶人”，以辟咎也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "遇主于巷，无咎。",
    "xiaoxiang": "“遇主于巷”，未失道也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "见舆曳，其牛掣；其人天且劓。无初有终。",
    "xiaoxiang": "“见舆曳”，位不当也。“无初有终”，遇刚也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "睽孤，遇元夫，交孚，厉无咎。",
    "xiaoxiang": "“交孚”“无咎”，志行也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "悔亡，厥宗噬肤，往何咎？",
    "xiaoxiang": "“厥宗噬肤”，往有庆也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "睽孤，见豕负涂，载鬼一车，先张之弧，后说之弧；匪寇婚媾，往遇雨则吉。",
    "xiaoxiang": "“遇雨”之“吉”，群疑亡也。"
   }
  ]
 },
 "39": {
  "guaxu": 39,
  "guaming": "水山蹇",
  "jianming": "蹇",
  "guaci": "利西南，不利东北；利见大人，贞吉。",
  "daxiang": "山上有水，蹇。君子以反身修德。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "往蹇，来誉。",
    "xiaoxiang": "“往蹇，来誉”，宜待也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "王臣蹇蹇，匪躬之故。",
    "xiaoxiang": "“王臣蹇蹇”，终无尤也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "往蹇，来反。",
    "xiaoxiang": "“往蹇，来反”，内喜之也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "往蹇，来连。",
    "xiaoxiang": "“往蹇，来连”，当位实也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "大蹇，朋来。",
    "xiaoxiang": "“大蹇，朋来”，以中节也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "往蹇，来硕；吉，利见大人。",
    "xiaoxiang": "“往蹇，来硕”，志在内也；“利见大人”，以从贵也。"
   }
  ]
 },
 "40": {
  "guaxu": 40,
  "guaming": "雷水解",
  "jianming": "解",
  "guaci": "利西南。无所往，其来复吉。有攸往，夙吉。",
  "daxiang": "雷雨作，解。君子以赦过宥罪。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "无咎。",
    "xiaoxiang": "刚柔之际，义“无咎”也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "田获三狐，得黄矢；贞吉。",
    "xiaoxiang": "九二“贞吉”，得中道也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "负且乘，致寇至，贞吝。",
    "xiaoxiang": "“负且乘”，亦可丑也；自我致戎，又谁咎也？"
   },
   {
    "yaoming": "九四",
    "yaoci": "解而拇，朋至斯孚。",
    "xiaoxiang": "“解而拇”，未当位也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "君子维有解，吉，有孚于小人。",
    "xiaoxiang": "“君子”“有解”，小人退也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "公用射隼于高墉之上，获之，无不利。",
    "xiaoxiang": "“公用射隼”，以解悖也。"
   }
  ]
 },
 "41": {
  "guaxu": 41,
  "guaming": "山泽损",
  "jianming": "损",
  "guaci": "有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。",
  "daxiang": "山下有泽，损。君子以惩忿窒欲。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "已事遄往，无咎；酌损之。",
    "xiaoxiang": "“已事遄往”，尚合志也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "利贞，征凶；弗损益之。",
    "xiaoxiang": "九二“利贞”，中以为志也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "三人行，则损一人；一人行，则得其友。",
    "xiaoxiang": "“一人行”，三则疑也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "损其疾，使遄有喜，无咎。",
    "xiaoxiang": "“损其疾”，亦可喜也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "或益之十朋之龟，弗克违，元吉。",
    "xiaoxiang": "六五“元吉”，自上祐也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "弗损益之，无咎。贞吉，利有攸往，得臣无家。",
    "xiaoxiang": "“弗损益之”，大得志也。"
   }
  ]
 },
 "42": {
  "guaxu": 42,
  "guaming": "风雷益",
  "jianming": "益",
  "guaci": "利有攸往，利涉大川。",
  "daxiang": "风雷，益。君子以见善则迁，有过则改。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "利用为大作，元吉，无咎。",
    "xiaoxiang": "“元吉，无咎”，下不厚事也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "或益之十朋之龟，弗克违。永贞吉；王用享于帝，吉。",
    "xiaoxiang": "“或益之”，自外来也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "益之用凶事，无咎；有孚中行，告公用圭。",
    "xiaoxiang": "益“用凶事”，固有之也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "中行，告公从，利用为依迁国。",
    "xiaoxiang": "“告公从”，以益志也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "有孚惠心，勿问元吉。有孚惠我德。",
    "xiaoxiang": "“有孚惠心”，“勿问”之矣；“惠我德”，大得志也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "莫益之，或击之，立心勿恒，凶。",
    "xiaoxiang": "“莫益之”，偏辞也；“或击之”，自外来也。"
   }
  ]
 },
 "43": {
  "guaxu": 43,
  "guaming": "泽天夬",
  "jianming": "夬",
  "guaci": "扬于王庭，孚号有厉；告自邑，不利即戎，利有攸往。",
  "daxiang": "泽上于天，夬。君子以施禄及下，居德则忌。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "壮于前趾，往不胜为咎。",
    "xiaoxiang": "“不胜”而“往”，咎也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "惕号，莫夜有戎，勿恤。",
    "xiaoxiang": "“有戎”“勿恤”，得中道也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "壮于頄，有凶。君子夬夬独行，遇雨若濡，有愠无咎。",
    "xiaoxiang": "“君子夬夬”，终无咎也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "臀无肤，其行次且；牵羊悔亡，闻言不信。",
    "xiaoxiang": "“其行次且”，位不当也；“闻言不信”，聪不明也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "苋陆夬夬，中行无咎。",
    "xiaoxiang": "“中行无咎”，中未光也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "无号，终有凶。",
    "xiaoxiang": "“无号”之“凶”，终不可长也。"
   }
  ]
 },
 "44": {
  "guaxu": 44,
  "guaming": "天风姤",
  "jianming": "姤",
  "guaci": "女壮，勿用取女。",
  "daxiang": "天下有风，姤。后以施命诰四方。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "系于金柅，贞吉；有攸往，见凶，羸豕孚踯躅。",
    "xiaoxiang": "“系于金柅”，柔道牵也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "包有鱼，无咎，不利宾。",
    "xiaoxiang": "“包有鱼”，义不及宾也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "臀无肤，其行次且；厉，无大咎。",
    "xiaoxiang": "“其行次且”，行未牵也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "包无鱼，起凶。",
    "xiaoxiang": "“无鱼”之“凶”，远民也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "以杞包瓜，含章，有陨自天。",
    "xiaoxiang": "九五“含章”，中正也；“有陨自天”，志不舍命也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "姤其角，吝，无咎。",
    "xiaoxiang": "“姤其角”，上穷吝也。"
   }
  ]
 },
 "45": {
  "guaxu": 45,
  "guaming": "泽地萃",
  "jianming": "萃",
  "guaci": "亨，王假有庙，利见大人，亨，利贞；用大牲吉，利有攸往。",
  "daxiang": "泽上于地，萃。君子以除戎器，戒不虞。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "有孚不终，乃乱乃萃；若号，一握为笑，勿恤，往无咎。",
    "xiaoxiang": "“乃乱乃萃”，其志乱也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "引吉，无咎；孚乃利用禴。",
    "xiaoxiang": "“引吉，无咎”，中未变也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "萃如，嗟如，无攸利；往无咎，小吝。",
    "xiaoxiang": "“往无咎”，上巽也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "大吉，无咎。",
    "xiaoxiang": "“大吉，无咎”，位不当也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "萃有位，无咎；匪孚，元永贞，悔亡。",
    "xiaoxiang": "“萃有位”，志未光也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "赍咨涕洟，无咎。",
    "xiaoxiang": "“赍咨涕洟”，未安上也。"
   }
  ]
 },
 "46": {
  "guaxu": 46,
  "guaming": "地风升",
  "jianming": "升",
  "guaci": "元亨，用见大人，勿恤。南征吉。",
  "daxiang": "地中生木，升。君子以顺德，积小以高大。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "允升，大吉。",
    "xiaoxiang": "“允升，大吉”，上合志也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "孚乃利用禴，无咎。",
    "xiaoxiang": "九二之“孚”，有喜也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "升虚邑。",
    "xiaoxiang": "“升虚邑”，无所疑也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "王用亨于岐山，吉无咎。",
    "xiaoxiang": "“王用亨于岐山”，顺事也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "贞吉，升阶。",
    "xiaoxiang": "“贞吉，升阶”，大得志也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "冥升，利于不息之贞。",
    "xiaoxiang": "“冥升在上”，消不富也。"
   }
  ]
 },
 "47": {
  "guaxu": 47,
  "guaming": "泽水困",
  "jianming": "困",
  "guaci": "亨。贞，大人吉，无咎；有言不信。",
  "daxiang": "泽无水，困。君子以致命遂志。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "臀困于株木，入于幽谷，三岁不觌。",
    "xiaoxiang": "“入于幽谷”，幽不明也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "困于酒食，朱绂方来，利用享祀；征凶，无咎。",
    "xiaoxiang": "“困于酒食”，中有庆也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "困于石，据于蒺藜，入于其宫，不见其妻，凶。",
    "xiaoxiang": "“据于蒺藜”，乘刚也；“入于其宫，不见其妻”，不祥也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "来徐徐，困于金车，吝，有终。",
    "xiaoxiang": "“来徐徐”，志在下也；虽不当位，有与也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "劓刖，困于赤绂，乃徐有说，利用祭祀。",
    "xiaoxiang": "“劓刖”，志未得也。“乃徐有说”，以中直也。“利用祭祀”，受福也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "困于葛藟，于臲卼，曰动悔，有悔。征吉。",
    "xiaoxiang": "“困于葛藟”，未当也；“动悔，有悔”，吉行也。"
   }
  ]
 },
 "48": {
  "guaxu": 48,
  "guaming": "水风井",
  "jianming": "井",
  "guaci": "改邑不改井，无丧无得，往来井井；汔至，亦未繘井，羸其瓶，凶。",
  "daxiang": "木上有水，井。君子以劳民劝相。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "井泥不食，旧井无禽。",
    "xiaoxiang": "“井泥不食”，下也；“旧井无禽”，时舍也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "井谷射鲋，瓮敝漏。",
    "xiaoxiang": "“井谷射鲋”，无与也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "井渫不食，为我心恻；可用汲，王明，并受其福。",
    "xiaoxiang": "“井渫不食”，行恻也；求“王明”，受福也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "井甃，无咎。",
    "xiaoxiang": "“井甃，无咎”，修井也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "井冽，寒泉食。",
    "xiaoxiang": "“寒泉”之“食”，中正也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "井收勿幕，有孚元吉。",
    "xiaoxiang": "“元吉”在上，大成也。"
   }
  ]
 },
 "49": {
  "guaxu": 49,
  "guaming": "泽火革",
  "jianming": "革",
  "guaci": "巳日乃孚，元亨利贞，悔亡。",
  "daxiang": "泽中有火，革。君子以治历明时。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "巩用黄牛之革。",
    "xiaoxiang": "“巩用黄牛”，不可以有为也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "巳日乃革之，征吉，无咎。",
    "xiaoxiang": "“巳日”“革之”，行有嘉也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "征凶，贞厉；革言三就，有孚。",
    "xiaoxiang": "“革言三就”，又何之矣！"
   },
   {
    "yaoming": "九四",
    "yaoci": "悔亡，有孚改命，吉。",
    "xiaoxiang": "“改命”之“吉”，信志也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "大人虎变，未占有孚。",
    "xiaoxiang": "“大人虎变”，其文炳也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "君子豹变，小人革面；征凶，居贞吉。",
    "xiaoxiang": "“君子豹变”，其文蔚也；“小人革面”，顺以从君也。"
   }
  ]
 },
 "50": {
  "guaxu": 50,
  "guaming": "火风鼎",
  "jianming": "鼎",
  "guaci": "元吉，亨。",
  "daxiang": "木上有火，鼎。君子以正位凝命。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "鼎颠趾，利出否；得妾以其子，无咎。",
    "xiaoxiang": "“鼎颠趾”，未悖也；“利出否”，以从贵也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "鼎有实，我仇有疾，不我能即，吉。",
    "xiaoxiang": "“鼎有实”，慎所之也；“我仇有疾”，终无尤也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "鼎耳革，其行塞。雉膏不食；方雨亏悔，终吉。",
    "xiaoxiang": "“鼎耳革”，失其义也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "鼎折足，覆公餗，其形渥，凶。",
    "xiaoxiang": "“覆公餗”，信如何也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "鼎黄耳，金铉，利贞。",
    "xiaoxiang": "“鼎黄耳”，中以为实也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "鼎玉铉，大吉，无不利。",
    "xiaoxiang": "“玉铉”在上，刚柔节也。"
   }
  ]
 },
 "51": {
  "guaxu": 51,
  "guaming": "震为雷",
  "jianming": "震",
  "guaci": "亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。",
  "daxiang": "洊雷，震。君子以恐惧修省。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "震来虩虩，后笑言哑哑，吉。",
    "xiaoxiang": "“震来虩虩”，恐致福也；“笑言哑哑”，后有则也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "震来厉，亿丧贝，跻于九陵，勿逐，七日得。",
    "xiaoxiang": "“震来厉”，乘刚也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "震苏苏，震行无眚。",
    "xiaoxiang": "“震苏苏”，位不当也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "震遂泥。",
    "xiaoxiang": "“震遂泥”，未光也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "震往来，厉；亿无丧，有事。",
    "xiaoxiang": "“震往来，厉”，危行也；其事在中，大无丧也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "震索索，视矍矍，征凶。震不于其躬，于其邻，无咎。婚媾有言。",
    "xiaoxiang": "“震索索”，中未得也；虽“凶”“无咎”，畏邻戒也。"
   }
  ]
 },
 "52": {
  "guaxu": 52,
  "guaming": "艮为山",
  "jianming": "艮",
  "guaci": "艮其背，不获其身；行其庭，不见其人，无咎。",
  "daxiang": "兼山，艮。君子以思不出其位。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "艮其趾，无咎，利永贞。",
    "xiaoxiang": "“艮其趾”，未失正也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "艮其腓，不拯其随，其心不快。",
    "xiaoxiang": "“不拯其随”，未退听也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "艮其限，列其夤，厉熏心。",
    "xiaoxiang": "“艮其限”，危“熏心”也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "艮其身，无咎。",
    "xiaoxiang": "“艮其身”，止诸躬也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "艮其辅，言有序，悔亡。",
    "xiaoxiang": "“艮其辅”，以中正也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "敦艮，吉。",
    "xiaoxiang": "“敦艮”之“吉”，以厚终也。"
   }
  ]
 },
 "53": {
  "guaxu": 53,
  "guaming": "风山渐",
  "jianming": "渐",
  "guaci": "女归吉，利贞。",
  "daxiang": "山上有木，渐。君子以居贤德善俗。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "鸿渐于干；小子厉，有言，无咎。",
    "xiaoxiang": "“小子”之“厉”，义无咎也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "鸿渐于磐，饮食衎衎，吉。",
    "xiaoxiang": "“饮食衎衎”，不素饱也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "鸿渐于陆，夫征不复，妇孕不育，凶；利御寇。",
    "xiaoxiang": "“夫征不复”，离群丑也；“妇孕不育”，失其道也；“利”用“御寇”，顺相保也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "鸿渐于木，或得其桷，无咎。",
    "xiaoxiang": "“或得其桷”，顺以巽也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "鸿渐于陵，妇三岁不孕；终莫之胜，吉。",
    "xiaoxiang": "“终莫之胜，吉”，得所愿也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "鸿渐于陆，其羽可用为仪，吉。",
    "xiaoxiang": "“其羽可用为仪，吉”，不可乱也。"
   }
  ]
 },
 "54": {
  "guaxu": 54,
  "guaming": "雷泽归妹",
  "jianming": "归妹",
  "guaci": "征凶，无攸利。",
  "daxiang": "泽上有雷，归妹。君子以永终知敝。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "归妹以娣，跛能履，征吉。",
    "xiaoxiang": "“归妹以娣”，以恒也；“跛能履”“吉”，相承也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "眇能视，利幽人之贞。",
    "xiaoxiang": "“利幽人之贞”，未变常也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "归妹以须，反归以娣。",
    "xiaoxiang": "“归妹以须”，未当也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "归妹愆期，迟归有时。",
    "xiaoxiang": "“愆期”之志，有待而行也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "帝乙归妹，其君之袂，不如其娣之袂良；月几望，吉。",
    "xiaoxiang": "“帝乙归妹”，“不如其娣之袂良”也，其位在中，以贵行也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "女承筐，无实；士刲羊，无血。无攸利。",
    "xiaoxiang": "上六“无实”，“承”虚“筐”也。"
   }
  ]
 },
 "55": {
  "guaxu": 55,
  "guaming": "雷火丰",
  "jianming": "丰",
  "guaci": "亨，王假之；勿忧，宜日中。",
  "daxiang": "雷电皆至，丰。君子以折狱致刑。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "遇其配主，虽旬无咎，往有尚。",
    "xiaoxiang": "“虽旬无咎”，过旬灾也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "丰其蔀，日中见斗。往得疑疾，有孚发若，吉。",
    "xiaoxiang": "“有孚发若”，信以发志也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "丰其沛，日中见沬；折其右肱，无咎。",
    "xiaoxiang": "“丰其沛”，不可大事也；“折其右肱”，终不可用也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "丰其蔀，日中见斗，遇其夷主，吉。",
    "xiaoxiang": "“丰其蔀”，位不当也；“日中见斗”，幽不明也；“遇其夷主，吉”，行也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "来章，有庆誉，吉。",
    "xiaoxiang": "六五之“吉”，“有庆”也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "丰其屋，蔀其家，窥其户，阒其无人，三岁不觌，凶。",
    "xiaoxiang": "“丰其屋”，天际翔也；“窥其户，阒其无人”，自藏也。"
   }
  ]
 },
 "56": {
  "guaxu": 56,
  "guaming": "火山旅",
  "jianming": "旅",
  "guaci": "小亨，旅贞吉。",
  "daxiang": "山上有火，旅。君子以明慎用刑而不留狱。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "旅琐琐，斯其所取灾。",
    "xiaoxiang": "“旅琐琐”，志穷灾也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "旅即次，怀其资，得童仆，贞。",
    "xiaoxiang": "“得童仆，贞”，终无尤也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "旅焚其次，丧其童仆，贞厉。",
    "xiaoxiang": "“旅焚其次”，亦以伤矣；以旅与下，其义“丧”也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "旅于处，得其资斧，我心不快。",
    "xiaoxiang": "“旅于处”，未得位也；“得其资斧”，心未快也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "射雉，一矢亡；终以誉命。",
    "xiaoxiang": "“终以誉命”，上逮也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "鸟焚其巢，旅人先笑后号啕；丧牛于易，凶。",
    "xiaoxiang": "以旅在上，其义“焚”也；“丧牛于易”，终莫之闻也。"
   }
  ]
 },
 "57": {
  "guaxu": 57,
  "guaming": "巽为风",
  "jianming": "巽",
  "guaci": "小亨，利有攸往，利见大人。",
  "daxiang": "随风，巽。君子以申命行事。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "进退，利武人之贞。",
    "xiaoxiang": "“进退”，志疑也；“利武人之贞”，志治也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "巽在床下，用史巫纷若，吉，无咎。",
    "xiaoxiang": "“纷若”之“吉”，得中也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "频巽，吝。",
    "xiaoxiang": "“频巽”之“吝”，志穷也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "悔亡，田获三品。",
    "xiaoxiang": "“田获三品”，有功也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "贞吉，悔亡，无不利。无初有终。先庚三日，后庚三日，吉。",
    "xiaoxiang": "九五之“吉”，位正中也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "巽在床下，丧其资斧，贞凶。",
    "xiaoxiang": "“巽在床下”，上穷也；“丧其资斧”，正乎“凶”也。"
   }
  ]
 },
 "58": {
  "guaxu": 58,
  "guaming": "兑为泽",
  "jianming": "兑",
  "guaci": "亨，利贞。",
  "daxiang": "丽泽，兑。君子以朋友讲习。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "和兑，吉。",
    "xiaoxiang": "“和兑”之“吉”，行未疑也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "孚兑，吉，悔亡。",
    "xiaoxiang": "“孚兑”之“吉”，信志也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "来兑，凶。",
    "xiaoxiang": "“来兑”之“凶”，位不当也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "商兑未宁，介疾有喜。",
    "xiaoxiang": "九四之“喜”，有庆也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "孚于剥，有厉。",
    "xiaoxiang": "“孚于剥”，位正当也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "引兑。",
    "xiaoxiang": "上六“引兑”，未光也。"
   }
  ]
 },
 "59": {
  "guaxu": 59,
  "guaming": "风水涣",
  "jianming": "涣",
  "guaci": "亨，王假有庙，利涉大川，利贞。",
  "daxiang": "风行水上，涣。先王以享于帝，立庙。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "用拯马壮，吉。",
    "xiaoxiang": "初六之“吉”，顺也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "涣奔其机，悔亡。",
    "xiaoxiang": "“涣奔其机”，得愿也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "涣其躬，无悔。",
    "xiaoxiang": "“涣其躬”，志在外也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "涣其群，元吉；涣有丘，匪夷所思。",
    "xiaoxiang": "“涣其群，元吉”，光大也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "涣汗其大号，涣王居，无咎。",
    "xiaoxiang": "“王居”“无咎”，正位也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "涣其血去逖出，无咎。",
    "xiaoxiang": "“涣其血”，远害也。"
   }
  ]
 },
 "60": {
  "guaxu": 60,
  "guaming": "水泽节",
  "jianming": "节",
  "guaci": "亨，苦节，不可贞。",
  "daxiang": "泽上有水，节。君子以制数度，议德行。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "不出户庭，无咎。",
    "xiaoxiang": "“不出户庭”，知通塞也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "不出门庭，凶。",
    "xiaoxiang": "“不出门庭，凶”，失时极也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "不节若，则嗟若，无咎。",
    "xiaoxiang": "“不节”之“嗟”，又谁“咎”也？"
   },
   {
    "yaoming": "六四",
    "yaoci": "安节，亨。",
    "xiaoxiang": "“安节”之“亨”，承上道也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "甘节，吉。往有尚。",
    "xiaoxiang": "“甘节”之“吉”，居位中也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "苦节，贞凶，悔亡。",
    "xiaoxiang": "“苦节，贞凶”，其道穷也。"
   }
  ]
 },
 "61": {
  "guaxu": 61,
  "guaming": "风泽中孚",
  "jianming": "中孚",
  "guaci": "豚鱼吉，利涉大川，利贞。",
  "daxiang": "泽上有风，中孚。君子以议狱缓死。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "虞吉，有他不燕。",
    "xiaoxiang": "初九“虞吉”，志未变也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "鸣鹤在阴，其子和之；我有好爵，吾与尔靡之。",
    "xiaoxiang": "“其子和之”，中心愿也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "得敌，或鼓或罢，或泣或歌。",
    "xiaoxiang": "“或鼓或罢”，位不当也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "月几望，马匹亡，无咎。",
    "xiaoxiang": "“马匹亡”，绝类上也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "有孚挛如，无咎。",
    "xiaoxiang": "“有孚挛如”，位正当也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "翰音登于天，贞凶。",
    "xiaoxiang": "“翰音登于天”，何可长也！"
   }
  ]
 },
 "62": {
  "guaxu": 62,
  "guaming": "雷山小过",
  "jianming": "小过",
  "guaci": "亨，利贞；可小事，不可大事；飞鸟遗之音，不宜上，宜下，大吉。",
  "daxiang": "山上有雷，小过。君子以行过乎恭，丧过乎哀，用过乎俭。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "飞鸟以凶。",
    "xiaoxiang": "“飞鸟以凶”，不可如何也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "过其祖，遇其妣；不及其君，遇其臣，无咎。",
    "xiaoxiang": "“不及其君”，臣不可过也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "弗过防之，从或戕之，凶。",
    "xiaoxiang": "“从或戕之”，凶如何也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "无咎，弗过遇之；往厉必戒，勿用永贞。",
    "xiaoxiang": "“弗过遇之”，位不当也；“往厉必戒”，终不可长也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "密云不雨，自我西郊；公弋取彼在穴。",
    "xiaoxiang": "“密云不雨”，已上也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "弗遇过之；飞鸟离之，凶，是谓灾眚。",
    "xiaoxiang": "“弗遇过之”，已亢也。"
   }
  ]
 },
 "63": {
  "guaxu": 63,
  "guaming": "水火既济",
  "jianming": "既济",
  "guaci": "亨小，利贞。初吉终乱。",
  "daxiang": "水在火上，既济。君子以思患而豫防之。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "曳其轮，濡其尾，无咎。",
    "xiaoxiang": "“曳其轮”，义无咎也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "妇丧其茀，勿逐，七日得。",
    "xiaoxiang": "“七日得”，以中道也。"
   },
   {
    "yaoming": "九三",
    "yaoci": "高宗伐鬼方，三年克之；小人勿用。",
    "xiaoxiang": "“三年克之”，惫也。"
   },
   {
    "yaoming": "六四",
    "yaoci": "繻有衣袽，终日戒。",
    "xiaoxiang": "终日戒，有所疑也。"
   },
   {
    "yaoming": "九五",
    "yaoci": "东邻杀牛，不如西邻之禴祭，实受其福。",
    "xiaoxiang": "“东邻杀牛，不如西邻”之时也；“实受其福”，吉大来也。"
   },
   {
    "yaoming": "上六",
    "yaoci": "濡其首，厉。",
    "xiaoxiang": "“濡其首，厉”，何可久也！"
   }
  ]
 },
 "64": {
  "guaxu": 64,
  "guaming": "火水未济",
  "jianming": "未济",
  "guaci": "亨，小狐汔济，濡其尾，无攸利。",
  "daxiang": "火在水上，未济。君子以慎辨物居方。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "濡其尾，吝。",
    "xiaoxiang": "“濡其尾”，亦不知极也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "曳其轮，贞吉。",
    "xiaoxiang": "九二“贞吉”，中以行正也。"
   },
   {
    "yaoming": "六三",
    "yaoci": "未济，征凶，利涉大川。",
    "xiaoxiang": "“未济，征凶”，位不当也。"
   },
   {
    "yaoming": "九四",
    "yaoci": "贞吉，悔亡；震用伐鬼方，三年有赏于大国。",
    "xiaoxiang": "“贞吉，悔亡”，志行也。"
   },
   {
    "yaoming": "六五",
    "yaoci": "贞吉，无悔；君子之光，有孚，吉。",
    "xiaoxiang": "“君子之光”，其晖“吉”也。"
   },
   {
    "yaoming": "上九",
    "yaoci": "有孚于饮酒；无咎，濡其首，有孚失是。",
    "xiaoxiang": "“饮酒”濡首，亦不知节也。"
   }
  ]
 }
}
