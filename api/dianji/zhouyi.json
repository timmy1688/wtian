  ]
 },
 "17": {
  "guaxu": 17,
  "guaming": "泽雷随",
  "jianming": "随",
  "guaci": "元亨，利贞，无咎。",
  "daxiang": "泽中有雷，随。君子以向晦入宴息。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "官有渝，贞吉；出门交有功。",
    "xiaoxiang": "“官有渝”，从正“吉”也；“出门交有功”，不失也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "系小子，失丈夫。",
    "xiaoxiang": "“系小子”，弗兼与也。"
