    "yaoci": "不事王侯，高尚其事。",
    "xiaoxiang": "“不事王侯”，志可则也。"
   }
  ]
 },
 "19": {
  "guaxu": 19,
  "guaming": "地泽临",
  "jianming": "临",
  "guaci": "元亨，利贞；至于八月，有凶。",
  "daxiang": "泽上有地，临。君子以教思无穷，容保民无疆。",
  "yao": [
   {
    "yaoming": "初九",
    "yaoci": "咸临，贞吉。",
    "xiaoxiang": "“咸临，贞吉”，志行正也。"
   },
   {
    "yaoming": "九二",
    "yaoci": "咸临，吉，无不利。",
    "xiaoxiang": "“咸临，吉，无不利”，未顺命也。"
