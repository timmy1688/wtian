 "16": {
  "guaxu": 16,
  "guaming": "雷地豫",
  "jianming": "豫",
  "guaci": "利建侯，行师。",
  "daxiang": "雷出地奋，豫；先王以作乐崇德，殷荐之上帝，以配祖考。",
  "yao": [
   {
    "yaoming": "初六",
    "yaoci": "鸣豫，凶。",
    "xiaoxiang": "初六“鸣豫”，志穷“凶”也。"
   },
   {
    "yaoming": "六二",
    "yaoci": "介于石，不终日，贞吉。",
