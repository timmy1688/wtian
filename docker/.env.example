# 复制为服务器部署目录下的 .env（chmod 600），docker compose 自动读取；勿提交到仓库
DEEPSEEK_API_KEY=sk-your-deepseek-key
# 与 redis/conf/redis.conf 中的 requirepass 一致
RD_PASSWORD=change-me
# 后端镜像版本，./wtian.sh deploy 会自动更新
API_TAG=latest
# 可选
# DEEPSEEK_MODEL=deepseek-v4-flash
# WHITELIST_IPS=127.0.0.1
# ACCESS_LIMIT_PER_DAY=10
